generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Non-pooled connection for migrations (Neon/Vercel set this automatically)
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String      @id @default(cuid())
  email         String?     @unique
  passwordHash  String?     @map("password_hash")
  instagramId   String?     @unique @map("instagram_id")
  name          String?
  image         String?
  // Set by an admin to revoke access; blocks sign-in and every API call
  disabledAt    DateTime?   @map("disabled_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  artists       UserArtist[]
  accounts      Account[]
  sessions      Session[]
  invitesSent   Invite[]    @relation("InviteCreatedBy")
  inviteUsed    Invite?     @relation("InviteUsedBy")
  apiUsage      ApiUsage[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Artist {
  id               String    @id @default(cuid())
  instagramHandle  String    @unique @map("instagram_handle")
  displayName      String?   @map("display_name")
  bio              String?
  profilePicUrl    String?   @map("profile_pic_url")
  // unknown | personal | business | creator
  accountType      String    @default("unknown") @map("account_type")
  bioLastFetchedAt DateTime? @map("bio_last_fetched_at")
  // Where the last bio came from: business_discovery | provider (HikerAPI)
  fetchSource      String?   @map("fetch_source")
  // Bio fetch queue: pending | fetched | unavailable (no profile from any source) | failed
  fetchStatus      String    @default("pending") @map("fetch_status")
  fetchAttempts    Int       @default(0) @map("fetch_attempts")
  fetchError       String?   @map("fetch_error")
  // Set when a request claims the artist, so concurrent tabs don't fetch it twice
  fetchClaimedAt   DateTime? @map("fetch_claimed_at")
  // Recent-work media queue — mirrors the bio queue but for Instagram posts
  mediaLastFetchedAt DateTime? @map("media_last_fetched_at")
  mediaClaimedAt     DateTime? @map("media_claimed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  users            UserArtist[]
  locations        ArtistLocation[]
  media            ArtistMedia[]

  @@index([fetchStatus])
  @@map("artists")
}

// Recent Instagram posts for an artist, fetched via Business Discovery's media
// edge. Powers the "Recent work" feed. Instagram CDN URLs expire after a few
// hours, so rows are refreshed (upserted) whenever the artist's media is stale.
model ArtistMedia {
  id         String   @id @default(cuid())
  artistId   String   @map("artist_id")
  // Instagram's media id — stable across refreshes
  igMediaId  String   @map("ig_media_id")
  // IMAGE | VIDEO | CAROUSEL_ALBUM
  mediaType  String   @map("media_type")
  // Display image URL (thumbnail for videos). Expires — refreshed on fetch.
  imageUrl   String   @map("image_url")
  permalink  String
  caption    String?
  takenAt    DateTime @map("taken_at")
  fetchedAt  DateTime @default(now()) @map("fetched_at")

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, igMediaId])
  @@index([artistId])
  @@map("artist_media")
}

model UserArtist {
  id       String  @id @default(cuid())
  userId   String  @map("user_id")
  artistId String  @map("artist_id")
  notes    String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([userId, artistId])
  @@map("user_artists")
}

model ArtistLocation {
  id           String    @id @default(cuid())
  artistId     String    @map("artist_id")
  locationName String    @map("location_name")
  city         String?
  country      String?
  lat          Float?
  lng          Float?
  isPrimary    Boolean   @default(false) @map("is_primary")
  isGuestSpot  Boolean   @default(false) @map("is_guest_spot")
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  source       String    @default("bio")

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@map("artist_locations")
}


// Single-use registration link. Registration is invite-only (admins, listed in
// ADMIN_EMAILS, can register without one).
model Invite {
  id          String    @id @default(cuid())
  code        String    @unique
  // Who the invite is for — shown on the admin page only
  note        String?
  createdById String    @map("created_by_id")
  usedById    String?   @unique @map("used_by_id")
  usedAt      DateTime? @map("used_at")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  createdBy User  @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy    User? @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@map("invites")
}

// Daily call counters for paid / metered APIs. scope is "global" or a user id.
// kind: e.g. "bio_parse" (Claude), "search", "profile" (paid Instagram provider)
model ApiUsage {
  id     String   @id @default(cuid())
  scope  String
  userId String?  @map("user_id")
  kind   String
  day    DateTime @db.Date
  count  Int      @default(0)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scope, kind, day])
  @@index([userId])
  @@map("api_usage")
}
