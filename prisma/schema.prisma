generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Non-pooled connection for migrations (Neon/Vercel set this automatically)
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String      @id @default(cuid())
  email         String?     @unique
  passwordHash  String?     @map("password_hash")
  instagramId   String?     @unique @map("instagram_id")
  name          String?
  image         String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  artists       UserArtist[]
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Artist {
  id               String    @id @default(cuid())
  instagramHandle  String    @unique @map("instagram_handle")
  displayName      String?   @map("display_name")
  bio              String?
  profilePicUrl    String?   @map("profile_pic_url")
  accountType      String    @default("unknown") @map("account_type")
  bioLastFetchedAt DateTime? @map("bio_last_fetched_at")
  // Bio fetch queue: pending | fetched | unavailable (no public professional profile) | failed
  fetchStatus      String    @default("pending") @map("fetch_status")
  fetchAttempts    Int       @default(0) @map("fetch_attempts")
  fetchError       String?   @map("fetch_error")
  // Set when a request claims the artist, so concurrent tabs don't fetch it twice
  fetchClaimedAt   DateTime? @map("fetch_claimed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  users            UserArtist[]
  locations        ArtistLocation[]

  @@index([fetchStatus])
  @@map("artists")
}

model UserArtist {
  id       String  @id @default(cuid())
  userId   String  @map("user_id")
  artistId String  @map("artist_id")
  notes    String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([userId, artistId])
  @@map("user_artists")
}

model ArtistLocation {
  id           String    @id @default(cuid())
  artistId     String    @map("artist_id")
  locationName String    @map("location_name")
  city         String?
  country      String?
  lat          Float?
  lng          Float?
  isPrimary    Boolean   @default(false) @map("is_primary")
  isGuestSpot  Boolean   @default(false) @map("is_guest_spot")
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  source       String    @default("bio")

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@map("artist_locations")
}

