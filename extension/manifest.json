{
  "manifest_version": 3,
  "name": "travel-ink",
  "version": "0.1.0",
  "description": "Add tattoo artists to travel-ink straight from their Instagram profile.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
