# Database
# Pooled URL for the app; unpooled URL for migrations. Locally both point at Docker.
DATABASE_URL="postgresql://user:password@localhost:5432/travelink"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/travelink"

# NextAuth
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Admins (comma-separated). Admins can register without an invite and use /admin.
ADMIN_EMAILS=""

# Anthropic (Claude): an API key, or no key with workload identity federation, which is used
# when the rule ID is set (see docs/development.md)
ANTHROPIC_API_KEY=""
ANTHROPIC_FEDERATION_RULE_ID=""
ANTHROPIC_ORGANIZATION_ID=""
ANTHROPIC_SERVICE_ACCOUNT_ID=""
# Only when the federation rule covers more than one workspace
ANTHROPIC_WORKSPACE_ID=""

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Instagram Business Discovery (official Graph API) — fetches artist bios.
# Optional: without these, artists are saved but stay "waiting for bio".
# Token: long-lived user token (instagram_basic, pages_show_list, business_management)
# User ID: your Instagram professional account ID (see docs/development.md)
INSTAGRAM_APP_ACCESS_TOKEN=""
INSTAGRAM_APP_USER_ID=""

# Dev auth bypass (skips login in development)
DEV_AUTH_BYPASS=
